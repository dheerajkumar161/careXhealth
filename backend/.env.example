# SQLite database (relative paths resolve from the working directory; default: backend/carexhealth.db)
# DATABASE_URL=sqlite:///./carexhealth.db

# Session signing secret - use a long random string in production
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- LLM chain: Groq (primary, then fallback model) → local Ollama → deterministic rule engine ---
# https://console.groq.com/keys — without a key Groq is skipped
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=
# Vision-capable Groq model for photos/scans of discharge notes and prescriptions
GROQ_VISION_MODEL=

# Local fallback (https://ollama.com), used when Groq is unavailable
OLLAMA_BASE_URL=http://localhost:11434
# Any chat model you have pulled, e.g. `ollama pull qwen2.5:3b`
OLLAMA_MODEL=
# Optional vision-capable model for reading photos/scans of notes, e.g. `ollama pull llama3.2-vision`
OLLAMA_VISION_MODEL=
LLM_TIMEOUT_SECONDS=90
FORCE_RULE_ENGINE=false

# Monitoring agent: minutes an alert may stay unacknowledged before escalating to the next level
ESCALATION_MINUTES=15
# APScheduler interval (seconds) for reminders, missed-dose/appointment detection, adherence and escalation
AGENT_CYCLE_SECONDS=60
SCHEDULER_ENABLED=true

# Demo mode relaxes time windows (record doses / sessions / results ahead of schedule). Never enable in production.
DEMO_MODE=false

# Optional: require this code to create clinician / test-center accounts
SIGNUP_INVITE_CODE=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ───────── Production hardening (v2.1) ─────────
# "production" refuses to start with the default AUTH_SECRET, DEMO_MODE=true or a wildcard CORS origin, and sets secure cookies + HSTS
ENVIRONMENT=development
# COOKIE_SECURE=            # default: true in production
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
MAX_UPLOAD_MB=8
LOG_JSON=false
# Bearer token required to scrape /metrics (otherwise loopback only)
METRICS_TOKEN=

# Escalation ladder: minutes before nurse→doctor, then doctor→on-call (empty = ESCALATION_MINUTES for every step)
ESCALATION_LADDER=

# ───────── Outbound email / SMS (all off until configured) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Twilio-style SMS; use TWILIO_FROM=whatsapp:+14155238886 for WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Non-urgent messages wait until quiet hours end (local hours); ALERT messages are always sent immediately
QUIET_HOURS_START=22
QUIET_HOURS_END=7
DELIVERY_MAX_ATTEMPTS=5
